---
import {
  SKILL_CATEGORIES,
  casePath,
  cvPath,
  casesPath,
  getCV,
  getLang,
  homePath,
  labPath,
  otherLang,
  securityPath,
  t,
} from "@/i18n"
import { caseKey, formatMonth, getCases } from "@/lib/cases"
import type { TerminalContext } from "@/lab/terminal"

interface Props {
  variant?: "home" | "lab"
  autoplay?: string
}

const { variant = "home", autoplay } = Astro.props
const lang = getLang(Astro.url)
const ui = t(lang)
const cv = getCV(lang)
const { basics } = cv
const cases = (await getCases(lang)).filter((entry) => !entry.data.draft)

const env = (globalThis as { process?: { env: Record<string, string | undefined> } }).process?.env
const build = (env?.COMMIT_REF ?? "local").slice(0, 7)

const year = (date: string) => new Date(date).getUTCFullYear()

const context: TerminalContext = {
  lang,
  name: basics.name,
  label: basics.label,
  summary: basics.summary,
  location: `${basics.location.city}, ${basics.location.region}`,
  email: basics.email,
  links: Object.fromEntries(
    basics.profiles.map((profile) => [profile.network.toLowerCase(), profile.url])
  ),
  startYear: Math.min(...cv.work.map((job) => year(job.startDate))),
  metrics: basics.metrics,
  now: cv.now.items,
  skills: SKILL_CATEGORIES.map((category) => ({
    category: ui.skillCategories[category],
    items: cv.skills.filter((skill) => skill.category === category).map((skill) => skill.name),
  })).filter((group) => group.items.length > 0),
  work: cv.work.map((job) => ({
    name: job.name,
    position: job.position,
    years: `${year(job.startDate)}–${job.endDate ? year(job.endDate) : ui.present}`,
  })),
  cases: cases.map((entry) => ({
    key: caseKey(entry),
    title: entry.data.title,
    url: casePath(lang, caseKey(entry)),
    date: formatMonth(entry.data.date, lang),
  })),
  paths: {
    home: homePath(lang),
    otherHome: homePath(otherLang(lang)),
    cv: cvPath(lang),
    cases: casesPath(lang),
    lab: labPath(lang),
    security: securityPath(lang),
  },
  sections:
    lang === "en"
      ? { about: "about", now: "now", experience: "experience", cases: "cases", education: "education", skills: "skills" }
      : { "sobre-mi": "about", ahora: "now", experiencia: "experience", casos: "cases", educacion: "education", habilidades: "skills" },
  build,
}
---

<div
  class:list={["terminal", variant, "no-print"]}
  data-terminal
  data-variant={variant}
  data-autoplay={autoplay}
  data-context={JSON.stringify(context)}
>
  <div class="chrome">
    <span class="dots" aria-hidden="true"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></span>
    <span class="title" aria-hidden="true">guest@gastonmardones: ~</span>
    <span class="hint">{ui.terminalHint}</span>
  </div>
  <div class="log" data-log role="log" aria-live="polite" aria-label={ui.terminalTitle}></div>
  <form class="input-row" data-form autocomplete="off">
    <label class="prompt" data-prompt for={`term-${variant}`}>guest@gastonmardones:~$</label>
    <input
      id={`term-${variant}`}
      data-input
      type="text"
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
      enterkeyhint="send"
      aria-label={ui.terminalTitle}
    />
  </form>
</div>

<script>
  import { mountTerminal } from "@/lab/terminal"

  document.querySelectorAll<HTMLElement>("[data-terminal]").forEach((el) => mountTerminal(el))
</script>

<style>
  .terminal {
    --t-bg: #0d1117;
    --t-bar: #161b22;
    --t-fg: #c9d1d9;
    --t-dim: #8b949e;
    --t-accent: #2dd4bf;
    --t-ok: #3fb950;
    --t-err: #ff7b72;
    --t-title: #e6edf3;

    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--t-bg);
    color: var(--t-fg);
    border: 1px solid #30363d;
    border-radius: 12px;
    box-shadow: 0 20px 60px -20px rgb(0 0 0 / 0.45), 0 0 0 1px rgb(255 255 255 / 0.02) inset;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.55;
    overflow: hidden;
    cursor: text;
  }

  .terminal.home {
    height: 300px;
  }

  .terminal.lab {
    height: min(68vh, 620px);
    min-height: 420px;
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 14px;
    background: var(--t-bar);
    border-bottom: 1px solid #30363d;
  }

  .dots {
    display: inline-flex;
    gap: 7px;
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .red {
    background: #ff5f57;
  }

  .yellow {
    background: #febc2e;
  }

  .green {
    background: #28c840;
  }

  .title {
    flex: 1;
    color: var(--t-dim);
    font-size: 0.72rem;
    margin-left: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .log {
    flex: 1;
    overflow-y: auto;
    padding: 12px 16px 4px;
    scrollbar-width: thin;
    scrollbar-color: #30363d transparent;
  }

  .log :global(.line) {
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 1.55em;
  }

  .log :global(.cmd) {
    color: var(--t-title);
  }

  .log :global(.dim) {
    color: var(--t-dim);
  }

  .log :global(.accent) {
    color: var(--t-accent);
  }

  .log :global(.ok) {
    color: var(--t-ok);
  }

  .log :global(.err) {
    color: var(--t-err);
  }

  .log :global(.title) {
    color: var(--t-title);
    font-weight: 700;
  }

  .log :global(a) {
    color: var(--t-accent);
    text-decoration: underline;
  }

  .input-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 16px 10px;
  }

  .prompt {
    color: var(--t-accent);
    white-space: nowrap;
  }

  input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--t-title);
    font: inherit;
    caret-color: var(--t-accent);
    padding: 0;
  }

  .hint {
    color: #6e7681;
    font-size: 0.65rem;
    white-space: nowrap;
  }

  @media (width <= 600px) {
    .hint,
    .title {
      display: none;
    }

    .prompt {
      max-width: 45%;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .terminal.home {
      height: 340px;
    }
  }
</style>
