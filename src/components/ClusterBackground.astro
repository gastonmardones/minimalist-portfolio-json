---
// Fondo animado del Hero: un "cluster" de nodos (pods) que se conectan entre sí
// y con el cursor. Se pausa fuera de pantalla y queda estático con reduced motion.
---

<canvas class="cluster-bg" aria-hidden="true" data-cluster></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-cluster]")
  const ctx = canvas?.getContext("2d")

  if (canvas && ctx) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    const LINK = 120
    let width = 0
    let height = 0
    let visible = true
    let frame = 0
    const mouse = { x: -9999, y: -9999 }

    type Node = { x: number; y: number; vx: number; vy: number; r: number; pulse: number }
    let nodes: Node[] = []

    const accent = () => getComputedStyle(document.documentElement).getPropertyValue("--accent").trim() || "#0f766e"

    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      width = rect.width
      height = rect.height
      canvas.width = width * dpr
      canvas.height = height * dpr
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      const count = Math.round(Math.min(70, Math.max(24, (width * height) / 9000)))
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        r: Math.random() * 1.6 + 1,
        pulse: Math.random() * Math.PI * 2,
      }))
    }

    const draw = () => {
      const color = accent()
      ctx.clearRect(0, 0, width, height)

      for (const n of nodes) {
        if (!reduce) {
          n.x += n.vx
          n.y += n.vy
          n.pulse += 0.02
          if (n.x < 0 || n.x > width) n.vx *= -1
          if (n.y < 0 || n.y > height) n.vy *= -1
        }
      }

      ctx.strokeStyle = color
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i]
          const b = nodes[j]
          const d = Math.hypot(a.x - b.x, a.y - b.y)
          if (d < LINK) {
            ctx.globalAlpha = (1 - d / LINK) * 0.18
            ctx.lineWidth = 1
            ctx.beginPath()
            ctx.moveTo(a.x, a.y)
            ctx.lineTo(b.x, b.y)
            ctx.stroke()
          }
        }
        const n = nodes[i]
        const dm = Math.hypot(n.x - mouse.x, n.y - mouse.y)
        if (dm < LINK * 1.4) {
          ctx.globalAlpha = (1 - dm / (LINK * 1.4)) * 0.45
          ctx.beginPath()
          ctx.moveTo(n.x, n.y)
          ctx.lineTo(mouse.x, mouse.y)
          ctx.stroke()
        }
      }

      ctx.fillStyle = color
      for (const n of nodes) {
        const near = Math.hypot(n.x - mouse.x, n.y - mouse.y) < LINK
        ctx.globalAlpha = near ? 0.9 : 0.35 + Math.sin(n.pulse) * 0.15
        ctx.beginPath()
        ctx.arc(n.x, n.y, near ? n.r + 1.2 : n.r, 0, Math.PI * 2)
        ctx.fill()
      }
      ctx.globalAlpha = 1

      if (!reduce && visible) frame = requestAnimationFrame(draw)
    }

    const start = () => {
      cancelAnimationFrame(frame)
      frame = requestAnimationFrame(draw)
    }

    canvas.parentElement?.addEventListener("pointermove", (event) => {
      const rect = canvas.getBoundingClientRect()
      mouse.x = event.clientX - rect.left
      mouse.y = event.clientY - rect.top
      if (reduce) draw()
    })
    canvas.parentElement?.addEventListener("pointerleave", () => {
      mouse.x = mouse.y = -9999
    })

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting
      if (visible) start()
    }).observe(canvas)

    window.addEventListener("resize", () => {
      resize()
      start()
    })
    document.addEventListener("toggle-theme", () => requestAnimationFrame(draw))

    resize()
    start()
  }
</script>

<style>
  .cluster-bg {
    position: absolute;
    inset: -40px -10vw 0;
    width: calc(100% + 20vw);
    height: calc(100% + 40px);
    pointer-events: none;
    z-index: 0;
    mask-image: radial-gradient(ellipse at 70% 40%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 70% 40%, #000 30%, transparent 75%);
  }

  @media print {
    .cluster-bg {
      display: none;
    }
  }
</style>
