---
import Section from "../Section.astro"

import { getCV, getLang, t } from "@/i18n"
const lang = getLang(Astro.url)
const { work } = getCV(lang)
---

<Section title={t(lang).experience}>
  <ul>
    {
      work.map(
        ({ name, startDate, endDate, position, summary, highlights, url }) => {
          const startYear = new Date(startDate).getUTCFullYear()
          const endYear =
            endDate != null ? new Date(endDate).getUTCFullYear() : t(lang).present
          const years = `${startYear} - ${endYear}`

          return (
            <li>
              <article>
                <header>
                  <div>
                    <h3>
                      <a href={url} title={t(lang).see(name)} target="_blank">
                        {name}
                      </a>
                    </h3>
                    <h4>{position}</h4>
                  </div>

                  <time>{years}</time>
                </header>

                <footer>
                  <p>{summary}</p>
                  {highlights.filter(Boolean).length > 0 && (
                    <ul class="highlights">
                      {highlights.filter(Boolean).map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  )}
                </footer>
              </article>
            </li>
          )
        }
      )
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article a {
    color: #111;
  }

  article a:hover {
    text-decoration: underline;
  }

  article h4 {
    color: #222;
    font-weight: 400;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 8px;
    padding-left: 1.1rem;
    list-style: disc;
    font-size: 0.9rem;
    color: #333;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>
