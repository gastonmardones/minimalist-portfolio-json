---
import Section from "../Section.astro"

import { getCV, getLang, t } from "@/i18n"
const lang = getLang(Astro.url)
const ui = t(lang)
const { work } = getCV(lang)

const year = (date: string) => new Date(date).getUTCFullYear()
---

<Section title={ui.experience} id="experience">
  <ol class="timeline">
    {
      work.map(({ name, startDate, endDate, position, summary, highlights, url }) => {
        const years = `${year(startDate)} - ${endDate != null ? year(endDate) : ui.present}`
        const current = endDate == null

        return (
          <li class:list={[{ current }]}>
            <article>
              <header>
                <div>
                  <h3>
                    <a href={url} title={ui.see(name)} target="_blank" rel="noopener noreferrer">
                      {name}
                    </a>
                  </h3>
                  <h4>{position}</h4>
                </div>
                <time>{years}</time>
              </header>

              <p>{summary}</p>
              {highlights.length > 0 && (
                <ul class="highlights">
                  {highlights.map(({ text }) => (
                    <li>{text}</li>
                  ))}
                </ul>
              )}
            </article>
          </li>
        )
      })
    }
  </ol>
</Section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .timeline > li {
    position: relative;
    padding-left: 28px;
  }

  /* Línea vertical */
  .timeline > li::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 14px;
    bottom: -36px;
    width: 2px;
    background: var(--border);
  }

  .timeline > li:last-child::before {
    bottom: 0;
  }

  /* Punto */
  .timeline > li::after {
    content: "";
    position: absolute;
    left: 0;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--border-strong);
  }

  .timeline > li.current::after {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 6px;
  }

  h3 {
    font-size: 1.02rem;
    font-weight: 600;
  }

  h3 a:hover {
    color: var(--accent);
  }

  h4 {
    color: var(--fg-2);
    font-weight: 500;
    font-size: 0.92rem;
    margin-top: 2px;
  }

  time {
    color: var(--muted);
    font-size: 0.78rem;
    white-space: nowrap;
    padding-top: 3px;
  }

  article > p,
  .highlights {
    max-width: 80ch;
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 10px;
  }

  .highlights li {
    position: relative;
    padding-left: 16px;
    color: var(--fg-2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .highlights li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  @media print {
    .timeline > li::before,
    .timeline > li::after {
      display: none;
    }

    .timeline > li {
      padding-left: 0;
    }
  }
</style>
