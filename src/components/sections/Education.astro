---
import Section from "../Section.astro"

import { getCV, getLang, t } from "@/i18n"
const lang = getLang(Astro.url)
const ui = t(lang)
const { education } = getCV(lang)
---

<Section title={ui.education}>
  <ul>
    {
      education.map(({ institution, startDate, endDate, area }) => {
        const endYear = endDate != null ? new Date(endDate).getUTCFullYear() : ui.present
        const years =
          startDate != null ? `${new Date(startDate).getUTCFullYear()} - ${endYear}` : `${endYear}`

        return (
          <li>
            <article>
              <header>
                <h3>{institution}</h3>
                <time>{years}</time>
              </header>
              <p>{area}</p>
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 2px;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  time {
    color: var(--muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }
</style>
