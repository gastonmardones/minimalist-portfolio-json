---
import Section from "../Section.astro"

import { getCV, getLang, t } from "@/i18n"
const lang = getLang(Astro.url)
const { education } = getCV(lang)
---

<Section title={t(lang).education}>
  <ul>
    {
      education.map(({ institution, startDate, endDate, area }) => {
        const endYear =
          endDate != null ? new Date(endDate).getUTCFullYear() : t(lang).present
        const years =
          startDate != null
            ? `${new Date(startDate).getUTCFullYear()} - ${endYear}`
            : `${endYear}`

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>{institution}</h3>
                </div>

                <time>{years}</time>
              </header>

              <footer>
                <p>{area}</p>
              </footer>
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>
