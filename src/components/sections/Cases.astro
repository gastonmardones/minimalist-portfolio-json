---
import Section from "../Section.astro"
import CaseCard from "../CaseCard.astro"

import { casesPath, getLang, t } from "@/i18n"
import { getCases } from "@/lib/cases"

const lang = getLang(Astro.url)
const ui = t(lang)
const cases = (await getCases(lang)).slice(0, 4)
---

{
  cases.length > 0 && (
    <Section title={ui.cases} id="cases">
      <a slot="action" class="all" href={casesPath(lang)}>
        {ui.casesAll}
      </a>
      <p class="intro">{ui.casesIntro}</p>
      <ul>
        {cases.map((entry) => (
          <li>
            <CaseCard entry={entry} />
          </li>
        ))}
      </ul>
    </Section>
  )
}

<style>
  .intro {
    max-width: 75ch;
    margin-bottom: 16px;
  }

  .all {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .all:hover {
    text-decoration: underline;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (width <= 700px) {
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
