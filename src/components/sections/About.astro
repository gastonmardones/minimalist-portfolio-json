---
import Section from "../Section.astro"

import { getCV, getLang, t } from "@/i18n"
const lang = getLang(Astro.url)
const { summary } = getCV(lang).basics
---

<Section title={t(lang).about} id="about">
  <p class="summary">
    {summary}
  </p>
</Section>

<style>
  .summary {
    color: var(--fg-2);
    font-size: 1rem;
    line-height: 1.7;
  }
</style>
