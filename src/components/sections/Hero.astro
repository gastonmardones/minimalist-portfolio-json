---
import { cvPath, getCV, getLang, t } from "@/i18n"
import Section from "@/components/Section.astro"
import Mail from "@/icons/Mail.astro"
import Phone from "@/icons/Phone.astro"
import LinkedIn from "@/icons/LinkedIn.astro"
import GitHub from "@/icons/GitHub.astro"
import WorldMap from "@/icons/WorldMap.astro"
import type { SocialIcon } from "@/types"
import Cv from "@/icons/cv.astro"
import ClusterBackground from "@/components/ClusterBackground.astro"

const lang = getLang(Astro.url)
const ui = t(lang)
const { name, label, image, location, profiles, phone, email, metrics } = getCV(lang).basics
const { city, region, address } = location

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
}

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn")
const linkedUrl = linkedInfo?.url

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" • ")
---

<Section reveal={false}>
  <div class="hero">
  <ClusterBackground />
  <div class="container">
    <div class="info">
      <h1>{name}</h1>
      <h2>{label}</h2>
      <span class="location">
        <WorldMap />
        <a href={`https://www.google.com/maps/place/${city} ${address}`} target="_blank" rel="noopener noreferrer">
          {address}, {city}, {region}
        </a>
      </span>
      <footer class="print">
        {printInfo}
      </footer>
      <footer class="no-print">
        {
          email && (
            <a href={`mailto:${email}`} title={ui.sendMail(name, email)} target="_blank" rel="noopener noreferrer">
              <Mail />
            </a>
          )
        }
        {
          phone && (
            <a href={`tel:${phone}`} title={ui.call(name, phone)} target="_blank" rel="noopener noreferrer">
              <Phone />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network]

            return (
              <a href={url} title={ui.visitProfile(name, network)} target="_blank" rel="noopener noreferrer">
                <Icon />
              </a>
            )
          })
        }
        <a href={cvPath(lang)} title={ui.cvOf(name)}>
          <Cv />
        </a>
      </footer>
    </div>
    <figure>
      <img src={image} alt={name} width="128" height="128" />
    </figure>
  </div>

  {
    metrics.length > 0 && (
      <dl class="metrics">
        {metrics.map(({ value, label }) => (
          <div>
            <dt>{value}</dt>
            <dd>{label}</dd>
          </div>
        ))}
      </dl>
    )
  }
  </div>
</Section>

<style>
  .hero {
    position: relative;
  }

  .container,
  .metrics {
    position: relative;
    z-index: 1;
  }

  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 32px;
  }

  h1 {
    font-size: 2.4rem;
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  h2 {
    color: var(--fg-2);
    font-weight: 500;
    font-size: 1.15rem;
    text-wrap: balance;
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 128px;
    height: auto;
    border-radius: 18px;
    box-shadow: var(--shadow);
  }

  .location {
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .location a:hover {
    color: var(--accent);
  }

  footer {
    color: var(--muted);
    font-size: 0.65rem;
    display: flex;
    gap: 6px;
    margin-top: 8px;
  }

  footer a {
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    padding: 4px;
    height: 34px;
    width: 34px;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  footer a:hover {
    color: var(--accent);
    background: var(--chip);
    border-color: var(--border-strong);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 2.25rem 0 0;
  }

  .metrics div {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
    background: var(--bg-soft);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.03em;
  }

  dd {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  @media (width <= 700px) {
    .container {
      flex-direction: column-reverse;
    }

    .info {
      justify-content: center;
      align-items: center;
      padding-right: 0;
      text-align: center;
    }

    figure {
      display: flex;
      justify-content: center;
      margin: 0 auto;
    }

    .metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media print {
    .metrics {
      display: none;
    }
  }
</style>
