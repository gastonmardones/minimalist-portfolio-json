---
import Layout from "@/layouts/Layout.astro"
import TopBar from "@/components/TopBar.astro"

import About from "@/components/sections/About.astro"
import Cases from "@/components/sections/Cases.astro"
import Certificates from "@/components/sections/Certificates.astro"
import Education from "@/components/sections/Education.astro"
import Experience from "@/components/sections/Experience.astro"
import Hero from "@/components/sections/Hero.astro"
import Now from "@/components/sections/Now.astro"
import Projects from "@/components/sections/Projects.astro"
import Skills from "@/components/sections/Skills.astro"
import KeyboardManager from "@/components/KeyboardManager.astro"
import Terminal from "@/components/Terminal.astro"
import StatusBar from "@/components/StatusBar.astro"
import Section from "@/components/Section.astro"

import { getCV, getLang, rssPath, t } from "@/i18n"

const lang = getLang(Astro.url)
const ui = t(lang)
const { basics, projects, certificates } = getCV(lang)
const { name, label } = basics
---

<Layout title={ui.pageTitle(name, label)}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={ui.casesTitle} href={rssPath(lang)} />
  <TopBar />
  <main>
    <Hero />
    <Section id="terminal" reveal={false}>
      <Terminal variant="home" />
    </Section>
    <About />
    <Now />
    <Experience />
    <Cases />
    <Education />
    {certificates.length > 0 && <Certificates />}
    {projects.length > 0 && <Projects />}
    <Skills />
  </main>

  <StatusBar />
  <KeyboardManager />
</Layout>

<style>
  main {
    padding: 2rem 4rem 5rem;
    margin: auto;
    width: 100%;
  }

  @media (width <= 700px) {
    main {
      padding: 1.5rem 2rem 5rem;
    }
  }
</style>
