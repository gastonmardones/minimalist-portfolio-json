---
interface Props {
  title?: string
  id?: string
  reveal?: boolean
}

const { title, id, reveal = true } = Astro.props
---

<section id={id} data-reveal={reveal ? "" : undefined}>
  {
    title && (
      <header>
        <h2>{title}</h2>
        <slot name="action" />
      </header>
    )
  }
  <slot />
</section>

<style>
  section {
    max-width: 720px;
    margin: 0 auto 56px;
    scroll-margin-top: 80px;
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  h2 {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.4;
  }

  @media (width <= 700px) {
    section {
      margin-bottom: 44px;
    }
  }
</style>
