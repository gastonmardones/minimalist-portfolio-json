---
interface Props {
  title?: string
  id?: string
  reveal?: boolean
}

const { title, id, reveal = true } = Astro.props
---

<section id={id} data-reveal={reveal ? "" : undefined}>
  {
    title && (
      <header>
        <div>
          {id && <span class="path" aria-hidden="true">~/{id}</span>}
          <h2>{title}</h2>
        </div>
        <slot name="action" />
      </header>
    )
  }
  <slot />
</section>

<style>
  section {
    max-width: 880px;
    margin: 0 auto 56px;
    scroll-margin-top: 80px;
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .path {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    margin-bottom: 2px;
    opacity: 0.85;
  }

  .path::before {
    content: "$ cd ";
    color: var(--muted);
  }

  h2 {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.4;
  }

  @media (width <= 700px) {
    section {
      margin-bottom: 44px;
    }
  }
</style>
