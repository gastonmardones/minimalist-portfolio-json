---
import Layout from "@/layouts/Layout.astro"
import Section from "@/components/Section.astro"
import TopBar from "@/components/TopBar.astro"

import { casePath, casesPath, getCV, otherLang, t } from "@/i18n"
import { caseKey, caseLang, formatMonth, type CaseEntry } from "@/lib/cases"

interface Props {
  entry: CaseEntry
  // ¿Existe la traducción al otro idioma?
  hasTranslation: boolean
}

const { entry, hasTranslation } = Astro.props
const lang = caseLang(entry)
const ui = t(lang)
const other = otherLang(lang)
const key = caseKey(entry)
const { name } = getCV(lang).basics
const { title, summary, date, tags, draft } = entry.data
const { Content } = await entry.render()

const alternates = {
  [lang]: casePath(lang, key),
  [other]: hasTranslation ? casePath(other, key) : casesPath(other),
} as Record<"es" | "en", string>
---

<Layout title={`${title} · ${name}`} description={summary} alternates={alternates}>
  <TopBar alternate={alternates[other]} />
  <main>
    <Section reveal={false}>
      <nav class="back"><a href={casesPath(lang)}>{ui.backCases}</a></nav>
      <header>
        <time datetime={date.toISOString().slice(0, 10)}>{formatMonth(date, lang)}</time>
        {draft && <span class="draft">{ui.draft}</span>}
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
        <ul class="tags">
          {tags.map((tag) => (
            <li>
              <a class="chip" href={`${casesPath(lang)}?tag=${encodeURIComponent(tag)}`}>{tag}</a>
            </li>
          ))}
        </ul>
      </header>
    </Section>

    <Section>
      <div class="prose">
        <Content />
      </div>
    </Section>

    <Section reveal={false}>
      <nav class="back"><a href={casesPath(lang)}>{ui.backCases}</a></nav>
    </Section>
  </main>
</Layout>

<style>
  main {
    padding: 2.5rem 4rem 4rem;
    margin: auto;
    width: 100%;
  }

  .back a {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .back a:hover {
    color: var(--accent);
  }

  header {
    margin-top: 20px;
  }

  time {
    color: var(--muted);
    font-size: 0.75rem;
  }

  time {
    display: inline-block;
  }

  time::first-letter {
    text-transform: uppercase;
  }

  .draft {
    margin-left: 8px;
    color: #b45309;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 6px 0 12px;
    text-wrap: balance;
  }

  .summary {
    font-size: 1.05rem;
    color: var(--fg-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .tags a:hover {
    color: var(--accent);
  }

  .prose :global(h2) {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 32px 0 10px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--fg-2);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .prose :global(ol),
  .prose :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 1.3rem;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  .prose :global(code) {
    background: var(--chip);
    border-radius: 4px;
    font-size: 0.85em;
    padding: 0.1em 0.35em;
  }

  .prose :global(pre) {
    background: var(--bg-soft) !important;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 0.78rem;
    line-height: 1.6;
    margin: 14px 0;
    overflow-x: auto;
    padding: 14px 16px;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    color: var(--fg);
  }

  @media (width <= 700px) {
    main {
      padding: 2rem;
    }
  }
</style>
